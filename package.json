{
  "name": "jobsearch-pal",
  "version": "0.1.0",
  "private": true,
  "description": "Save job posts from the page you're on, track each application's status, set reminders, back up and export. Free and local-only.",
  "type": "module",
  "engines": {
    "node": "^22.22.0 || >=24.15.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && node scripts/check-dist.ts && node scripts/licence-check.ts && node scripts/tasks.ts check",
    "package": "npm run verify && node scripts/package.ts",
    "measure": "node scripts/measure.ts",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/chrome": "0.3.7",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.8"
  },
  "dependencies": {
    "dexie": "4.4.7",
    "zod": "4.6.7"
  }
}
