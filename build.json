{
  "entries": [
    {
      "out": "background",
      "src": "src/background/index.ts",
      "format": "esm"
    },
    {
      "out": "sidepanel",
      "src": "src/sidepanel/main.ts",
      "format": "esm"
    },
    {
      "out": "page",
      "src": "src/page/main.ts",
      "format": "iife"
    }
  ],
  "static": [
    {
      "from": "_locales",
      "to": "_locales"
    },
    {
      "from": "src/ui",
      "to": "ui"
    }
  ]
}
